# Copy to .env and adjust. Never commit real secrets.
# Every OPSMITH_* setting is optional and shown with its default unless noted.

# --- Required for `docker compose` -------------------------------------------------------
# No default on purpose: the stack refuses to start without it.
# Generate one with:  openssl rand -hex 24   (hex is safe inside the database URL)
POSTGRES_PASSWORD=

# --- Credentials (set only the ones you use) ----------------------------------------------
GITHUB_TOKEN=
# Model providers. The default provider is offline and needs none of these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Storage -----------------------------------------------------------------------------
# OPSMITH_DATA_DIR=./data                 # object store, local PR state, SQLite database
# OPSMITH_DATABASE_URL=                   # postgresql+psycopg://user:pass@host:5432/db (default: SQLite in the data dir)

# --- Models -------------------------------------------------------------------------------
# Providers that may receive (redacted) data at all. Projects can only narrow this list.
# heuristic = offline rules; anthropic = Claude; openai = any OpenAI-compatible endpoint.
# OPSMITH_LLM_PROVIDER_ALLOWLIST=heuristic,anthropic,openai
# The "openai" provider's endpoint: OpenAI, Azure OpenAI, Ollama, vLLM, LM Studio, LiteLLM, ...
# OPSMITH_OPENAI_BASE_URL=https://api.openai.com/v1      # e.g. http://localhost:11434/v1 for Ollama
# OPSMITH_OPENAI_API_KEY_REF=env:OPENAI_API_KEY          # a local server needs no key
# OPSMITH_OPENAI_JSON_MODE=json_schema                   # json_object if the endpoint lacks json_schema
# OPSMITH_ANTHROPIC_API_KEY_REF=env:ANTHROPIC_API_KEY
# OPSMITH_ANTHROPIC_FALLBACKS=default     # server-side refusal fallbacks for Claude; "off" disables

# --- Execution sandbox -------------------------------------------------------------------
# docker: isolated containers (no network, read-only root, no capabilities). The default.
# local:  an unconfined subprocess. Development only; refused for non-local repositories.
# OPSMITH_SANDBOX_BACKEND=docker
# The image must already contain everything your build/lint/test commands need:
# the sandbox has no network, so nothing can be installed at run time.
# OPSMITH_SANDBOX_IMAGE=python:3.12-slim
# OPSMITH_WORK_DIR=                       # where execution checkouts live (default: system temp dir)

# --- Only with docker-compose.sandbox.yml -------------------------------------------------
# DOCKER_GID=                             # stat -c %g /var/run/docker.sock

# --- Host files and secrets ---------------------------------------------------------------
# The only directory file connectors and local-SCM repositories may read. Unset disables both.
# OPSMITH_LOCAL_ROOT=
# file:/path credential references must live under this directory.
# OPSMITH_SECRETS_DIR=/run/secrets

# --- Operations ---------------------------------------------------------------------------
# OPSMITH_BASE_URL=                       # public UI URL; makes pull requests link to their task
# OPSMITH_BASE_PATH=                      # serve under a path (/opsmith) behind a shared-domain proxy
# OPSMITH_WORKER_LEASE_SECONDS=900        # a crashed worker's job is retried after this long
# OPSMITH_LOG_LEVEL=INFO
# OPSMITH_LOG_JSON=true
# OPSMITH_BOT_NAME=Opsmith Bot            # author of agent commits
# OPSMITH_BOT_EMAIL=opsmith-bot@users.noreply.github.com
