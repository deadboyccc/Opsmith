# Copy to .env and adjust. Never commit real secrets.
OPSMITH_LOG_LEVEL=INFO
OPSMITH_LOG_JSON=true
# heuristic (offline, default) | anthropic
OPSMITH_LLM_PROVIDER=heuristic
# Providers that may receive (redacted) data at all.
OPSMITH_LLM_PROVIDER_ALLOWLIST=heuristic,anthropic
# local (scrubbed subprocess) | docker (network-isolated containers; needs a docker socket)
OPSMITH_SANDBOX_BACKEND=local
OPSMITH_SANDBOX_IMAGE=python:3.12-slim
# Server-side refusal fallbacks for Claude (default) or "off"
OPSMITH_ANTHROPIC_FALLBACKS=default
# Commit identity used for agent-authored commits
OPSMITH_BOT_NAME=Opsmith Bot
OPSMITH_BOT_EMAIL=opsmith-bot@users.noreply.github.com
# Credentials are referenced from config as env:NAME; set the values here or in a secret store.
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
POSTGRES_PASSWORD=change-me
